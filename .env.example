# Copy this file to ".env" and fill in your keys. NEVER commit your real .env.

# --- Report LLM (the ONLY stage that makes paid API calls) ---
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o

# Optional alternative report backends
# LLM_BACKEND=openai            # openai | gemini | groq
# GEMINI_API_KEY=
# GROQ_API_KEY=

# --- Diarization (pyannote.audio 4.x) ---
# 1. Create a token at https://hf.co/settings/tokens (classic "Read", or a
#    fine-grained token WITH "read access to public gated repos").
# 2. Accept the model terms (once) for ALL of:
#      https://hf.co/pyannote/speaker-diarization-community-1   (4.x pipeline)
#      https://hf.co/pyannote/segmentation-3.0
#      https://hf.co/pyannote/speaker-diarization-3.1           (legacy, optional)
HF_TOKEN=hf_...

# --- Optional overrides (everything below is auto-detected if omitted) ---
# AUDIT_DEVICE=cuda             # force cuda | cpu
# WHISPER_MODEL=large-v3        # tiny|base|small|medium|large-v3|distil-large-v3
# WHISPER_COMPUTE_TYPE=float16  # float16 (GPU) | int8 (CPU)
# YOLO_MODEL=yolo11m.pt
# SAMPLE_INTERVAL_SEC=2.0
# EXPECTED_SPEAKERS_DEFAULT=2
# AUDIT_WORK_DIR=               # where downloads/audio/frames are written
